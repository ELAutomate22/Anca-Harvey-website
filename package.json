{
  "name": "our-corner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev:full": "concurrently -k -n web,worker -c magenta,cyan \"pnpm dev:web\" \"pnpm dev:worker\"",
    "build": "tsc -b && vite build",
    "build:worker": "tsc -p tsconfig.worker.json --noEmit && wrangler deploy --dry-run --env production --outdir .wrangler/build",
    "lint": "eslint .",
    "test": "pnpm test:web && pnpm test:worker",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "test:web": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.worker.json --noEmit --pretty false",
    "preview": "vite preview",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply our-corner-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply our-corner-db --remote --env production",
    "db:provision:local": "node scripts/provision-users.mjs --local --dev",
    "db:provision:remote": "node scripts/provision-users.mjs --remote --env production",
    "deploy": "pnpm build && wrangler deploy --env production"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.19.0"
}
